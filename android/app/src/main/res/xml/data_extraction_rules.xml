<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup / transfer rules for Android 12 (API 31) and above.
  Cloud backup excludes the rotating JSON auto-backups under the app documents
  directory (data root/app_flutter/backups) — they duplicate the SQLite
  database, double the cleartext copies in Google Drive, and count against the
  ~25 MB Auto Backup quota (#36); the database alone restores everything.
  Device-to-device transfer has no quota, so it keeps the default (everything,
  including the local backup rotation).
  Both channels exclude app_flutter/.install_id (#62): the install fingerprint
  file must NOT follow the database to another device — the mismatch between
  the copied database's fingerprint and the missing/different file is how the
  app detects an OS-level restore and drops the old device's Google Drive
  sync identity (see lib/data/install_id.dart).
  Both channels also exclude app_flutter/.device_secrets (#68): the passwords
  for authenticated device APIs (the Apex controller login) live only in that
  file — the backed-up database deliberately has no column for them — and are
  documented as never leaving this phone, which only holds if neither the
  cloud backup nor the phone-to-phone transfer carries them (see
  lib/data/device_secrets.dart).
  Both channels also exclude app_flutter/.pro_entitlement (U19): the Pro
  unlock is bought per store account, not per aquarium, so it must not ride
  the database to another phone or another Google account. It cannot be a
  settings row for exactly that reason — the database is copied wholesale by
  these channels and a single row cannot be excluded from it. Restoring the
  purchase on the new device is what the stores' own "Restore purchases"
  button is for (see lib/data/entitlement.dart).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_flutter/backups"/>
        <exclude domain="root" path="app_flutter/.install_id"/>
        <exclude domain="root" path="app_flutter/.device_secrets"/>
        <exclude domain="root" path="app_flutter/.pro_entitlement"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_flutter/.install_id"/>
        <exclude domain="root" path="app_flutter/.device_secrets"/>
        <exclude domain="root" path="app_flutter/.pro_entitlement"/>
    </device-transfer>
</data-extraction-rules>
